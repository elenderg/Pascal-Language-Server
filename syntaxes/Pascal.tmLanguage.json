{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pascal",
  "scopeName": "source.pascal",
  "fileTypes": ["pas", "pp", "inc", "dpr", "lpr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#compiler-directives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#program-structure" },
    { "include": "#type-section" },
    { "include": "#constant-declarations" },
    { "include": "#variable-declarations" },
    { "include": "#declaration-keywords" },
    { "include": "#routine-declarations" },
    { "include": "#control-flow" },
    { "include": "#built-in-types" },
    { "include": "#constants" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pascal",
          "match": "//.*$"
        },
        {
          "name": "comment.block.curly.pascal",
          "begin": "\\{(?!\\$)",
          "end": "\\}"
        },
        {
          "name": "comment.block.parentheses.pascal",
          "begin": "\\(\\*(?!\\$)",
          "end": "\\*\\)"
        }
      ]
    },
    "compiler-directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.pascal",
          "begin": "\\{\\$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.directive.begin.pascal" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.directive.end.pascal" }
          },
          "patterns": [
            { "include": "#directive-contents" }
          ]
        },
        {
          "name": "meta.preprocessor.pascal",
          "begin": "\\(\\*\\$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.directive.begin.pascal" }
          },
          "end": "\\*\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.directive.end.pascal" }
          },
          "patterns": [
            { "include": "#directive-contents" }
          ]
        }
      ]
    },
    "directive-contents": {
      "patterns": [
        {
          "name": "keyword.control.directive.pascal",
          "match": "(?i)\\b(if|ifdef|ifndef|else|elseif|endif|include|define|undef|mode|modeswitch|apptype|R|resource|warning|error)\\b"
        },
        {
          "name": "constant.numeric.directive.pascal",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "string.unquoted.directive.pascal",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.single.pascal",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.pascal" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.pascal" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.pascal",
          "match": "''"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hexadecimal.pascal",
          "match": "\\$[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.pascal",
          "match": "%[01]+\\b"
        },
        {
          "name": "constant.numeric.octal.pascal",
          "match": "&[0-7]+\\b"
        },
        {
          "name": "constant.numeric.float.pascal",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?[Ee][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.pascal",
          "match": "\\b[0-9]+\\.[0-9]+(?:[Ee][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.pascal",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.character.code.pascal",
          "match": "#(?:[0-9]+|\\$[0-9A-Fa-f]+)"
        }
      ]
    },
    "program-structure": {
      "patterns": [
        {
          "match": "(?i)\\b(program|unit|library|package)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.program.pascal" },
            "2": { "name": "entity.name.section.pascal" }
          }
        },
        {
          "match": "(?i)\\b(uses)\\b",
          "captures": {
            "1": { "name": "keyword.other.uses.pascal" }
          }
        },
        {
          "name": "entity.name.namespace.pascal",
          "match": "(?i)(?<=\\buses\\s)(?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.other.section.pascal",
          "match": "(?i)\\b(interface|implementation|initialization|finalization)\\b"
        }
      ]
    },
    "type-section": {
      "begin": "(?i)\\b(type)\\b",
      "beginCaptures": {
        "1": { "name": "storage.type.section.pascal" }
      },
      "end": "(?i)(?=\\b(var|threadvar|const|resourcestring|procedure|function|constructor|destructor|operator|begin|initialization|finalization|implementation)\\b)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#compiler-directives" },
        { "include": "#type-declaration" }
      ]
    },
    "type-declaration": {
      "patterns": [
        {
          "name": "meta.array.index.pascal",
          "begin": "(?i)\\b(array)\\s*(\\[)",
          "beginCaptures": {
            "1": { "name": "storage.type.modifier.pascal" },
            "2": { "name": "punctuation.section.group.pascal" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.pascal" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            { "include": "#built-in-types" },
            {
              "name": "entity.name.type.constant.other.reference.pascal",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\.\\.)"
            },
            {
              "match": "(?<=\\.\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": { "name": "entity.name.type.constant.other.reference.pascal" }
              }
            },
            {
              "name": "entity.name.type.pascal",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "(?<=\\.\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.constant.other.reference.pascal" }
          }
        },
        {
          "match": "(?i)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(\\^)\\s*(?:(Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b|([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b)",
          "captures": {
            "1": { "name": "entity.name.type.pascal" },
            "2": { "name": "keyword.operator.assignment.pascal" },
            "3": { "name": "keyword.operator.pointer.pascal" },
            "4": { "name": "storage.type.built-in.pascal" },
            "5": { "name": "entity.name.type.pascal" }
          }
        },
        {
          "match": "(?i)\\b(of)(\\s+)(\\^?\\s*(Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b)",
          "captures": {
            "1": { "name": "storage.type.modifier.pascal" },
            "3": { "name": "storage.type.built-in.pascal" }
          }
        },
        {
          "match": "(?i)\\b(of)(\\s+)(\\^?\\s*[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.modifier.pascal" },
            "3": { "name": "entity.name.type.pascal" }
          }
        },
        {
          "begin": "(?i)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.type.pascal" },
            "2": { "name": "keyword.operator.assignment.pascal" },
            "0": { "name": "meta.type.enum.pascal" }
          },
          "end": "\\)\\s*;",
          "endCaptures": {
            "0": { "name": "punctuation.section.group.end.pascal" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#compiler-directives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "entity.name.type.constant.other.enum.pascal",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "begin": "(?i)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(?:(packed)\\s+)?(class|record|object|interface|dispinterface|class\\s+of|record\\s+helper|class\\s+helper|type\\s+helper)\\b",
          "beginCaptures": {
            "1": { "name": "entity.name.type.pascal" },
            "2": { "name": "keyword.operator.assignment.pascal" },
            "3": { "name": "storage.modifier.pascal" },
            "4": { "name": "storage.type.pascal" }
          },
          "end": "(?i)\\bend\\s*;",
          "endCaptures": {
            "0": { "name": "keyword.control.end.pascal" }
          },
          "name": "meta.type.definition.pascal",
          "patterns": [
            { "include": "#comments" },
            { "include": "#compiler-directives" },
            { "include": "#visibility" },
            { "include": "#routine-declarations" },
            { "include": "#member-declarations" },
            { "include": "#declaration-modifiers" },
            { "include": "#built-in-types" },
            { "include": "#constants" },
            { "include": "#control-flow" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "(?i)([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "entity.name.type.pascal" },
            "2": { "name": "keyword.operator.assignment.pascal" }
          }
        },
        {
          "name": "storage.type.modifier.pascal",
          "match": "(?i)\\b(packed|array|of|set|file|specialize|generic|helper)\\b"
        },
        {
          "name": "entity.name.type.pascal",
          "match": "(?<=\\bas\\s)[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "visibility": {
      "name": "storage.modifier.visibility.pascal",
      "match": "(?i)\\b(strict\\s+private|strict\\s+protected|private|protected|public|published|automated)\\b"
    },
    "member-declarations": {
      "patterns": [
        {
          "match": "(?i)(?<=:)\\s*(\\^?\\s*)((?!(?:Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b",
          "captures": {
            "2": { "name": "entity.name.type.pascal" }
          }
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.pascal" },
            "2": { "name": "punctuation.separator.type.pascal" }
          }
        },
        {
          "match": "(?i)\\b(property)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.property.pascal" },
            "2": { "name": "variable.other.property.pascal" }
          }
        },
        {
          "name": "keyword.other.property.pascal",
          "match": "(?i)\\b(read|write|stored|default|implements|index|nodefault)\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "storage.type.variable.pascal",
          "match": "(?i)\\b(var|threadvar|const|resourcestring|label)\\b"
        },
        {
          "match": "(?i)\\b(absolute|external|export|name|public|weakexternal)\\b",
          "captures": {
            "1": { "name": "storage.modifier.pascal" }
          }
        }
      ]
    },
    "variable-declarations": {
      "patterns": [
        {
          "begin": "(?i)\\b(var|threadvar)\\b",
          "beginCaptures": {
            "1": { "name": "storage.type.variable.pascal" }
          },
          "end": "(?i)(?=\\b(begin|procedure|function|constructor|destructor|operator|type|const|resourcestring|label|var|threadvar|initialization|finalization|implementation)\\b)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#compiler-directives" },
            {
              "match": "^\\s*((?:[A-Za-z_][A-Za-z0-9_]*\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*)(\\s*:)(?=\\s*[A-Za-z_^(@])",
              "captures": {
                "1": { "name": "variable.other.declaration.pascal" },
                "2": { "name": "punctuation.separator.type.pascal" }
              }
            },
            { "include": "#built-in-types" },
            {
              "match": "(?i)(?<=:)\\s*\\^?\\s*((?!(?:Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b",
              "captures": {
                "1": { "name": "entity.name.type.pascal" }
              }
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "^\\s*((?:[A-Za-z_][A-Za-z0-9_]*\\s*,\\s*)*[A-Za-z_][A-Za-z0-9_]*)(\\s*:)(?=\\s*[A-Za-z_^(@])",
          "captures": {
            "1": { "name": "variable.other.declaration.pascal" },
            "2": { "name": "punctuation.separator.type.pascal" }
          }
        }
      ]
    },
    "constant-declarations": {
      "patterns": [
        {
          "begin": "(?i)\\b(const)\\b",
          "beginCaptures": {
            "1": { "name": "storage.type.constant.pascal" }
          },
          "end": "(?i)(?=\\b(type|var|threadvar|resourcestring|label|procedure|function|constructor|destructor|operator|begin|initialization|finalization|implementation)\\b)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#compiler-directives" },
            {
              "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)(\\s*)(=)(?!=)",
              "captures": {
                "1": { "name": "variable.other.constant.definition.pascal" },
                "3": { "name": "keyword.operator.assignment.pascal" }
              }
            },
            { "include": "#built-in-types" },
            { "include": "#numbers" },
            { "include": "#strings" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "routine-declarations": {
      "patterns": [
        {
          "begin": "(?i)\\b(procedure|function|constructor|destructor|operator)\\s+((?:[A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*|\\[\\])",
          "beginCaptures": {
            "1": { "name": "storage.type.function.pascal" },
            "2": { "name": "entity.name.function.pascal" }
          },
          "end": "(?i)(?=\\b(begin|assembler)\\b|;)",
          "patterns": [
            {
              "name": "meta.parameters.pascal",
              "begin": "\\(",
              "beginCaptures": {
                "0": { "name": "punctuation.section.parameters.begin.pascal" }
              },
              "end": "\\)",
              "endCaptures": {
                "0": { "name": "punctuation.section.parameters.end.pascal" }
              },
              "patterns": [
                { "include": "#comments" },
                { "include": "#built-in-types" },
                {
                  "match": "(?i)\\b(var|const|out|constref)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(:)",
                  "captures": {
                    "1": { "name": "storage.modifier.parameter.pascal" },
                    "2": { "name": "variable.parameter.pascal" },
                    "3": { "name": "punctuation.separator.type.pascal" }
                  }
                },
                {
                  "match": "([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)\\s*(:)",
                  "captures": {
                    "1": { "name": "variable.parameter.pascal" },
                    "2": { "name": "punctuation.separator.type.pascal" }
                  }
                },
                {
                  "match": "(?i)(?<=:)\\s*\\^?\\s*((?!(?:Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b",
                  "captures": {
                    "1": { "name": "entity.name.type.pascal" }
                  }
                },
                { "include": "#operators" },
                { "include": "#punctuation" }
              ]
            },
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#built-in-types" },
            { "include": "#declaration-modifiers" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            {
              "match": "(?i)(?<=:)\\s*\\^?\\s*((?!(?:Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b)[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b",
              "captures": {
                "1": { "name": "entity.name.type.pascal" }
              }
            }
          ]
        }
      ]
    },
    "declaration-modifiers": {
      "name": "storage.modifier.routine.pascal",
      "match": "(?i)\\b(virtual|dynamic|override|abstract|overload|reintroduce|inline|static|assembler|external|forward|deprecated|platform|experimental|message|varargs|cdecl|stdcall|safecall|register|pascal|cdecl|interrupt|nostackframe|inline)\\b"
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.pascal",
          "match": "(?i)\\b(begin|end|if|then|else|case|of|for|to|downto|do|while|repeat|until|try|except|finally|raise|on|with|goto|break|continue|exit|inherited|yield|await)\\b"
        },
        {
          "name": "keyword.other.section.pascal",
          "match": "(?i)\\b(interface|implementation|initialization|finalization|uses)\\b"
        }
      ]
    },
    "built-in-types": {
      "name": "storage.type.built-in.pascal",
      "match": "(?i)\\b(Boolean|ByteBool|WordBool|LongBool|Byte|ShortInt|SmallInt|Integer|LongInt|LongWord|Cardinal|Int64|QWord|NativeInt|NativeUInt|Word|Real|Single|Double|Extended|Comp|Currency|Char|AnsiChar|WideChar|UnicodeChar|String|ShortString|AnsiString|WideString|UnicodeString|PChar|PAnsiChar|PWideChar|Pointer|Variant|TObject|TClass|TComponent|Text|File)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.pascal",
          "match": "(?i)\\b(true|false|nil)\\b"
        },
        {
          "name": "variable.language.pascal",
          "match": "(?i)\\b(Self|Result)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.pascal",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.member.pascal",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.other.pascal",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.control.operator.word.pascal",
          "match": "(?i)\\b(and|or|not|xor|shl|shr|div|mod|in|is|as)\\b"
        },
        {
          "name": "keyword.operator.assignment.pascal",
          "match": ":=|\\+=|-=|\\*=|/=|\\*\\*="
        },
        {
          "name": "keyword.operator.comparison.pascal",
          "match": "<=|>=|<>|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.pascal",
          "match": "\\+|-|\\*\\*|\\*|/"
        },
        {
          "name": "keyword.operator.address.pascal",
          "match": "@"
        },
        {
          "name": "keyword.operator.pointer.pascal",
          "match": "\\^"
        },
        {
          "name": "punctuation.accessor.pascal",
          "match": "\\."
        }
      ]
    },
    "punctuation": {
